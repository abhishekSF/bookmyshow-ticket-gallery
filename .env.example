# Gmail API (Required)
# Go to: https://console.cloud.google.com/project
# Create a new project or select existing one
# Enable Gmail API
# Go to Credentials > OAuth 2.0 Client IDs
# Create OAuth 2.0 Client (Desktop app type)
GMAIL_PROJECT_ID=your-google-cloud-project-id
GMAIL_CLIENT_ID=your-oauth-client-id
GMAIL_CLIENT_SECRET=your-oauth-client-secret

# OAuth token is saved automatically in ./tokens/token.json
# First run will open browser for consent

# Ollama (Optional for enrichment)
# Must have Ollama running locally with a model
# Start: ollama serve
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b  # or qwen2.5:7b-instruct
OLLAMA_TIMEOUT=60000  # ms
OLLAMA_ENABLE=false  # Set to true to enable enrichment

# TMDb API (Optional for poster fallback)
# Get API key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key
TMDB_ENABLE=true  # Enable for poster fallback

# Salesforce Headless 360 (Optional for pushing records)
# Requires Salesforce Dev Org and Connected App
SF_URL=https://test-dev-ed.sfdc.us
SF_CLIENT_ID=your-sfdc-connected-app-client-id
SF_CLIENT_SECRET=your-sfdc-connected-app-client-secret
SF_REFRESH_TOKEN=your-sfdc-refresh-token
SF_TENANT_ID=your-sfdc-tenant-id
SF_ENABLE=false  # Enable for pushing records to Salesforce

# Application
APP_NAME=bookmyshow-ticket-gallery