# Gmail API (required for fetch)
# Google Cloud → enable Gmail API → OAuth client → Desktop app
GMAIL_PROJECT_ID=your-google-cloud-project-id
GMAIL_CLIENT_ID=your-oauth-client-id
GMAIL_CLIENT_SECRET=your-oauth-client-secret
GMAIL_ENABLED=true

# Ollama (optional, local only). Models: llama3.1:8b or qwen2.5:7b-instruct
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_MS=60000
OLLAMA_ENABLE=false

# TMDb (optional poster lookup)
TMDB_API_KEY=your-tmdb-api-key
TMDB_ENABLE=true

# Salesforce Connected App (Ticket__c create/update). Callback: http://localhost:8765/callback
SF_URL=https://login.salesforce.com
SF_API_VERSION=v61.0
SF_CLIENT_ID=your-sfdc-connected-app-client-id
SF_CLIENT_SECRET=your-sfdc-connected-app-client-secret
SF_REFRESH_TOKEN=
SF_TENANT_ID=
SF_ENABLE=false
SF_HEADLESS_360_URL=https://api.salesforce.com/platform/mcp/v1/platform/headless-360

# Seam
TICKETS_JSON=../react-app/public/tickets.json
REVIEW_JSON=./data/review.json

APP_NAME=bookmyshow-ticket-gallery
